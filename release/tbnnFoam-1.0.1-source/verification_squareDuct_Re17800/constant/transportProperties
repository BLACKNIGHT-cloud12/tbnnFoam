FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// Target bulk Reynolds number: Re_b = 17800 (17,800)
// Re_b = U_b * D_h / nu = (1.0 m/s * 0.10 m) / 5.617978e-6 m^2/s = 17800
// Re_tau = 519 (Pirozzoli et al. 2018 benchmark)
nu              [0 2 -1 0 0 0 0] 5.617978e-06;

