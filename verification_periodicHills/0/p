FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    cyclicLeft
    {
        type            cyclic;
    }

    cyclicRight
    {
        type            cyclic;
    }

    hillLower
    {
        type            zeroGradient;
    }

    topWall
    {
        type            zeroGradient;
    }

    frontBack
    {
        type            empty;
    }
}

