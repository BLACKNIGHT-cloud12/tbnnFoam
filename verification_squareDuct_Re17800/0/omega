FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

// omega = sqrt(k)/(Cmu^0.25 * l) ~ 15.0 s^-1 with l = 0.07 * Dh = 0.007 m
internalField   uniform 15.0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 15.0;
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            omegaWallFunction;
        value           uniform 15.0;
    }
}

