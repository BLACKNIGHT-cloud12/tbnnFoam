FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Bulk inlet velocity: U_b = 1.0 m/s (Ux = 1, Uy = 0, Uz = 0)
// Hydraulic diameter: D_h = 0.10 m (2h x 2h duct with h = 0.05 m)
// Kinematic viscosity: nu = 5.617978e-6 m^2/s -> Re_b = 17800
internalField   uniform (1 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            noSlip;
    }
}

